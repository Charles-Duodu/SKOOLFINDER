# ==============================================================================
# SkoolFinder Ghana - Environment Configuration Template
# Copy this file to .env and configure with your production credentials
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=production
APP_URL=https://skoolfinder.com.gh
TZ=Africa/Accra

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
SESSION_LIFETIME_HOURS=24

# Enterprise Scaled Database Engine (PostgreSQL)
# For local Docker: postgres://skoolfinder_admin:skoolfinder_prod_password_2026@localhost:5432/skoolfinder_db
# For Render / Supabase / Neon: postgresql://[user]:[password]@[host]:5432/[db]?sslmode=require
DATABASE_URL=postgres://skoolfinder_admin:skoolfinder_prod_password_2026@localhost:5432/skoolfinder_db
PG_POOL_MAX=20

# Hubtel Ghana SMS Gateway (for BECE CSSPS, School Fees & Emergency Sickbay Alerts)
# Register at: https://hubtel.com/developers
HUBTEL_CLIENT_ID=gh_hubtel_live_client_id_here
HUBTEL_CLIENT_SECRET=gh_hubtel_live_client_secret_here
HUBTEL_SENDER_ID=SkoolFinder

# Paystack Mobile Money & Card Gateway (for GHS School Fees, Bus Passes & Book Loans)
# Supports MTN Mobile Money, Telecel Cash, AT Money, and Visa/Mastercard
# Register at: https://paystack.com/gh
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here

# NaSIA (National Schools Inspectorate Authority) Registry Verification
NASIA_API_ENDPOINT=https://api.nasia.gov.gh/v1/accreditation/verify
NASIA_PARTNER_KEY=nasia_partner_sch_direct_gh_2026

# Automated Backup Settings
MAX_BACKUPS=30
BACKUP_CRON_SCHEDULE="0 2 * * *"
