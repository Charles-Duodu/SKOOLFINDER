# ========================================================
# SKOOLFINDER GHANA - PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================

# Server Settings
PORT=3000
NODE_ENV=production

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Authentication Secret (JWT)
JWT_SECRET=your-secure-random-jwt-secret-key-32-chars

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=SkoolFinder Ghana <admissions@skoolfinder.com.gh>
SUPPORT_EMAIL=admissions@skoolfinder.com.gh
SCHOOL_ALERT_EMAIL=admissions@gis.edu.gh

# Optional SMTP Fallback
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_smtp_password
SMTP_SECURE=false

# Paystack Payment Gateway (Ghana GHS)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key

# Meta WhatsApp Cloud API (Meta Graph API v19.0 Driver)
WHATSAPP_ACCESS_TOKEN=EAAB_your_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id_here

# Hubtel Ghana SMS Gateway (GH₵ 0.045 / unit)
HUBTEL_CLIENT_ID=your_hubtel_client_id_here
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret_here
HUBTEL_SENDER_ID=SKOOLFINDER

# Error Monitoring (Optional Sentry)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
